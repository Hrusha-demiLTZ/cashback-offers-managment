# Local demonstration configuration only. Generate a private .env with:
# powershell -NoProfile -ExecutionPolicy Bypass -File .\scripts\setup-local-env.ps1
POSTGRES_DB=cashback_demo
POSTGRES_USER=cashback_app
POSTGRES_PASSWORD=__GENERATE_LOCAL_SECRET__

# Backend containers will connect to the Compose service, never a host/system database.
DATABASE_URL=postgresql+asyncpg://cashback_app:__GENERATE_LOCAL_SECRET__@db:5432/cashback_demo